erDiagram
    USUARIOS {
        int id PK
        string username UK
        string nombre
        string password_hash
        string rol "SOLICITANTE | COORDINADOR | TECNICO"
        int activo "0 | 1"
    }
    INCIDENCIAS {
        int id PK
        string codigo UK "INC-0001, solo para mostrar"
        string ubicacion
        string categoria
        string descripcion "20-500"
        string impacto "BAJO | ALTO"
        int riesgo_personas "0 | 1"
        string estado
        int autor_id FK
        string creada_en "UTC"
    }
    ASIGNACIONES {
        int id PK
        int incidencia_id FK, UK
        int tecnico_id FK
        int coordinador_id FK
        string asignada_en "UTC"
    }
    SOLUCIONES {
        int id PK
        int incidencia_id FK
        int tecnico_id FK
        string texto "20-800"
        string registrada_en "UTC"
    }
    EVENTOS {
        int id PK
        int incidencia_id FK
        string accion "CREAR, ASIGNAR, INICIAR, PROPONER_SOLUCION, CONFIRMAR, RECHAZAR, REABRIR"
        int autor_id FK
        string estado_anterior
        string estado_nuevo
        string detalle "solución o motivo"
        string creado_en "UTC"
    }
    USUARIOS ||--o{ INCIDENCIAS : "reporta"
    INCIDENCIAS ||--o| ASIGNACIONES : "tiene"
    USUARIOS ||--o{ ASIGNACIONES : "atiende / asigna"
    INCIDENCIAS ||--o{ SOLUCIONES : "acumula"
    USUARIOS ||--o{ SOLUCIONES : "registra"
    INCIDENCIAS ||--|{ EVENTOS : "historial"
    USUARIOS ||--o{ EVENTOS : "autor"
